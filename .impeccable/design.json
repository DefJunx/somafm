  "narrative": {
    "northStar": "The Tuning Rail",
    "overview": "Radio as spectrum. Every Station is a line on one rail, and the line carries the Station's genre hue everywhere it appears. State is told by line form (full, dashed, short, doubled) with a plain word beside it, never by colour alone. Dark charcoal ground, one grotesque, three type sizes, 1px hairlines, 4px corners, outline buttons and a single inverted bone primary.",
    "keyCharacteristics": [
      "Lines, not tiles: a Station is a hue line before it is a card.",
      "Six genre hues plus one reserved accent (sodium for Liked).",
      "Three integer type sizes: 13 / 16 / 40.",
      "Outline controls at a fixed 32px; one inverted bone primary.",
      "Flat; depth by plate-on-ground tone and hairlines, with one static hue bloom on live elements."
    ],
    "rules": [
      {
        "name": "The Reserved Sodium Rule",
        "body": "Sodium means Liked and nothing else.",
        "section": "colors"
      },
      {
        "name": "The Hue Identity Rule",
        "body": "A Station has one hue and it is identical on every surface.",
        "section": "colors"
      },
      {
        "name": "The Not-By-Colour Rule",
        "body": "Every hue-borne state is also carried by line form and a word.",
        "section": "colors"
      },
      {
        "name": "The Three Steps Rule",
        "body": "Only 13, 16 and 40px exist; vary weight, tracking and ink instead.",
        "section": "typography"
      },
      {
        "name": "The Tabular Where Aligned Rule",
        "body": "Tabular numerals only on times and counts that stack in a column.",
        "section": "typography"
      },
      {
        "name": "The Live-Only Bloom Rule",
        "body": "The 35% static hue bloom marks live state and nothing else.",
        "section": "elevation"
      },
      {
        "name": "The Flat Rule",
        "body": "Nothing else glows, lifts or casts a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do carry a Station's hue as --hue on its element and draw it as a line, tick, fill or ring.",
      "Do keep every line 1px except the live 2px line.",
      "Do pair every hue-borne state with a line form and a word.",
      "Do reserve sodium for Liked, and use a star for favourite Station.",
      "Do keep dim text at #918f8a or lighter on ground and plate.",
      "Do use only 13, 16 and 40px; vary weight, tracking and ink.",
      "Do honour reduced motion."
    ],
    "donts": [
      "Don't use a uniform tile grid with a play-button accent and a separate player card.",
      "Don't colour a Station differently between surfaces, or use sodium for anything but Liked.",
      "Don't add shadows, gradients or glow other than the 35% static live bloom.",
      "Don't add a second typeface or a fourth size.",
      "Don't rely on colour alone to show state."
    ]
  }
}